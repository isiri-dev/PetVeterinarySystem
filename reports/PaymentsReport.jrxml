<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="PaymentsReport" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="48321004-0000-4000-8000-000000000000">
	<query language="sql"><![CDATA[SELECT payment_id, appointment_id, CAST(amount AS DECIMAL(12,2)) AS amount, payment_date, payment_method, payment_status FROM payments ORDER BY payment_date DESC]]></query>
	<field name="payment_id" class="java.lang.Integer"/>
	<field name="appointment_id" class="java.lang.Integer"/>
	<field name="amount" class="java.math.BigDecimal"/>
	<field name="payment_date" class="java.util.Date"/>
	<field name="payment_method" class="java.lang.String"/>
	<field name="payment_status" class="java.lang.String"/>
	<variable name="GrandTotal" class="java.math.BigDecimal" calculation="Sum"><expression><![CDATA[$F{amount}]]></expression></variable>
	<title height="70">
		<element kind="staticText" x="0" y="8" width="802" height="32" fontName="SansSerif" fontSize="22.0" bold="true" hTextAlign="Center" vTextAlign="Middle"><text><![CDATA[Pet Veterinary System]]></text><box leftPadding="6" rightPadding="6"/></element>
		<element kind="staticText" x="0" y="38" width="802" height="22" fontName="SansSerif" fontSize="14.0" bold="true" hTextAlign="Center" vTextAlign="Middle" forecolor="#1F3A5F"><text><![CDATA[Payments Report]]></text><box leftPadding="6" rightPadding="6"/></element>
		<element kind="line" x="0" y="64" width="802" height="1" forecolor="#1F3A5F"><pen lineWidth="2.0" lineColor="#1F3A5F"/></element>
	</title>
	<columnHeader height="30">
