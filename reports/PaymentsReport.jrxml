		<element kind="staticText" x="90" y="4" width="120" height="24" fontName="SansSerif" fontSize="11.0" bold="true" hTextAlign="Center" vTextAlign="Middle" forecolor="#FFFFFF" mode="Opaque" backcolor="#1F3A5F"><text><![CDATA[Appointment ID]]></text><box leftPadding="6" rightPadding="6"/></element>
		<element kind="staticText" x="210" y="4" width="120" height="24" fontName="SansSerif" fontSize="11.0" bold="true" hTextAlign="Right" vTextAlign="Middle" forecolor="#FFFFFF" mode="Opaque" backcolor="#1F3A5F"><text><![CDATA[Amount]]></text><box leftPadding="6" rightPadding="6"/></element>
		<element kind="staticText" x="330" y="4" width="180" height="24" fontName="SansSerif" fontSize="11.0" bold="true" hTextAlign="Left" vTextAlign="Middle" forecolor="#FFFFFF" mode="Opaque" backcolor="#1F3A5F"><text><![CDATA[Payment Date]]></text><box leftPadding="6" rightPadding="6"/></element>
		<element kind="staticText" x="510" y="4" width="150" height="24" fontName="SansSerif" fontSize="11.0" bold="true" hTextAlign="Left" vTextAlign="Middle" forecolor="#FFFFFF" mode="Opaque" backcolor="#1F3A5F"><text><![CDATA[Method]]></text><box leftPadding="6" rightPadding="6"/></element>
		<element kind="staticText" x="660" y="4" width="142" height="24" fontName="SansSerif" fontSize="11.0" bold="true" hTextAlign="Left" vTextAlign="Middle" forecolor="#FFFFFF" mode="Opaque" backcolor="#1F3A5F"><text><![CDATA[Status]]></text><box leftPadding="6" rightPadding="6"/></element>
	</columnHeader>
	<detail>
		<band height="26">
			<element kind="rectangle" mode="Opaque" x="0" y="0" width="802" height="26" forecolor="#F3F6FA" backcolor="#F3F6FA"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression><pen lineWidth="0.0"/></element>
			<element kind="textField" x="0" y="0" width="90" height="26" fontName="SansSerif" fontSize="10.0" bold="false" hTextAlign="Center" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{payment_id}]]></expression><box leftPadding="6" rightPadding="6"/></element>
			<element kind="textField" x="90" y="0" width="120" height="26" fontName="SansSerif" fontSize="10.0" bold="false" hTextAlign="Center" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{appointment_id}]]></expression><box leftPadding="6" rightPadding="6"/></element>
			<element kind="textField" x="210" y="0" width="120" height="26" fontName="SansSerif" fontSize="10.0" bold="false" hTextAlign="Right" vTextAlign="Middle" pattern="#,##0.00" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{amount}]]></expression><box leftPadding="6" rightPadding="6"/></element>
			<element kind="textField" x="330" y="0" width="180" height="26" fontName="SansSerif" fontSize="10.0" bold="false" hTextAlign="Left" vTextAlign="Middle" pattern="yyyy-MM-dd HH:mm" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{payment_date}]]></expression><box leftPadding="6" rightPadding="6"/></element>
			<element kind="textField" x="510" y="0" width="150" height="26" fontName="SansSerif" fontSize="10.0" bold="false" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{payment_method}]]></expression><box leftPadding="6" rightPadding="6"/></element>
			<element kind="textField" x="660" y="0" width="142" height="26" fontName="SansSerif" fontSize="10.0" bold="false" hTextAlign="Left" vTextAlign="Middle" blankWhenNull="true" textAdjust="StretchHeight"><expression><![CDATA[$F{payment_status}]]></expression><box leftPadding="6" rightPadding="6"/></element>
			<element kind="line" x="0" y="25" width="802" height="1" forecolor="#D0D7E2"><pen lineWidth="0.75" lineColor="#D0D7E2"/></element>
